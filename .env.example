# Copy to .env (gitignored):  cp .env.example .env
# -----------------------------------------------------------------------------
# Jev, via OpenRouter — no TypeSafe account needed.
# Get a key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Model id on OpenRouter. typesafe/jev-1.13 resolves to a serving endpoint;
# ~typesafe/jev-latest currently lists none. Pin the dated build
# (e.g. typesafe/jev-1.13-20260917, echoed back in every response) once
# thresholds are tuned against it.
JEV_MODEL=typesafe/jev-1.13

# Override only if OpenRouter moves the endpoint out of /api/alpha/.
# JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# -----------------------------------------------------------------------------
# TypeSafe direct — only if an early-access key has arrived. Takes precedence
# over OPENROUTER_API_KEY when both are set.
# -----------------------------------------------------------------------------
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# -----------------------------------------------------------------------------
# Optional generative hook: an OpenAI-compatible chat/completions endpoint.
# This project runs on the same DGX Spark that llama-cpp-spark's `local-llm serve
# <model>` serves on, so it's loopback, not a network address -- no llama.cpp
# build here, just an HTTP client pointed at the port that command already opened.
# Leave LLM_BASE_URL unset and every escalation from the policy is queued for
# human review instead.
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://127.0.0.1:8082/v1
# LLM_MODEL=gpt-oss-120b
# LLM_API_KEY=

# Which model the --llm escalation hook calls: "local" (LLM_BASE_URL above) or
# "frontier" (the hosted model below). Lets you compare "Jev + gpt-oss" against
# "Jev + Terra" on exactly the escalated band.
# LLM_PROVIDER=local

# -----------------------------------------------------------------------------
# Hosted frontier model (OpenAI) -- the reference row in the comparison,
# `cascade run --backend frontier`. Same variable names llama-cpp-spark reads,
# so one .env serves both projects. Token counts come from the API; dollars are
# always list-price math from the three prices below (override if they change).
# gpt-5.6-terra rejects `logprobs`, so only the one-JSON-call shape is compared.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# FRONTIER_MODEL=gpt-5.6-terra
# FRONTIER_PRICE_INPUT_PER_MTOK=2.0
# FRONTIER_PRICE_CACHED_INPUT_PER_MTOK=0.20
# FRONTIER_PRICE_OUTPUT_PER_MTOK=12.0
