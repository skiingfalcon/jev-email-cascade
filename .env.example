# Copy to .env (gitignored):  cp .env.example .env
# -----------------------------------------------------------------------------
# Jev, via OpenRouter — no TypeSafe account needed.
# Get a key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Model id on OpenRouter. typesafe/jev-1.13 resolves to a serving endpoint;
# ~typesafe/jev-latest currently lists none. Pin the dated build
# (e.g. typesafe/jev-1.13-20260917, echoed back in every response) once
# thresholds are tuned against it.
JEV_MODEL=typesafe/jev-1.13

# Override only if OpenRouter moves the endpoint out of /api/alpha/.
# JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# -----------------------------------------------------------------------------
# TypeSafe direct — only if an early-access key has arrived. Takes precedence
# over OPENROUTER_API_KEY when both are set.
# -----------------------------------------------------------------------------
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# -----------------------------------------------------------------------------
# Optional generative hook: an OpenAI-compatible chat/completions endpoint
# (e.g. gpt-oss-120b on the Spark's llama-server). Leave LLM_BASE_URL unset
# and every escalation from the policy is queued for human review instead.
# -----------------------------------------------------------------------------
# LLM_BASE_URL=http://<spark-host>:8082/v1
# LLM_MODEL=gpt-oss-120b
# LLM_API_KEY=
